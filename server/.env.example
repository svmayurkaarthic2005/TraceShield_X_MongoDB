PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
CORE_URL=http://127.0.0.1:8000
INGEST_URL=http://127.0.0.1:8001
# Comma-separated list of allowed CORS origins (local + production)
ALLOWED_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# JWT auth — single operator account.
# AUTH_PASSWORD_HASH is a BOOTSTRAP value only: it seeds the password on
# first run (stored from then on in MongoDB's AuthState collection, since a
# running process can't durably rewrite its own .env). Changing this value
# after that first run has no effect — use POST /api/auth/change-password
# (requires the current password) instead. If MongoDB is down, login falls
# back to checking this value directly, with no rate-limit lockout available.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
AUTH_USERNAME=admin
# Generate with: node scripts/hash-password.js <your-password>
AUTH_PASSWORD_HASH=
