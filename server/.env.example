PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
CORE_URL=http://127.0.0.1:8000
INGEST_URL=http://127.0.0.1:8001
# Comma-separated list of allowed CORS origins (local + production)
ALLOWED_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# JWT auth — single operator account
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
AUTH_USERNAME=admin
# Generate with: node scripts/hash-password.js <your-password>
AUTH_PASSWORD_HASH=
