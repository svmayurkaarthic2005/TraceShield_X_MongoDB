PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/traceshield
CORE_URL=http://127.0.0.1:8000
INGEST_URL=http://127.0.0.1:8001
ALLOWED_ORIGIN=http://localhost:5173

# JWT auth — single operator account
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
AUTH_USERNAME=admin
# Generate with: node scripts/hash-password.js <your-password>
AUTH_PASSWORD_HASH=
